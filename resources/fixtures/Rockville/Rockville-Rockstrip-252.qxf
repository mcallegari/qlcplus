<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.3.0 GIT</Version>
  <Author>Fede79</Author>
 </Creator>
 <Manufacturer>Rockville</Manufacturer>
 <Model>Rockstrip 252</Model>
 <Type>LED Bar (Pixels)</Type>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="Master dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Strobe" Preset="ShutterStrobeSlowFast"/>
 <Channel Name="Running Speed">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255" Preset="SlowToFast">Running speed (slow to fast)</Capability>
 </Channel>
 <Channel Name="Chase Mode">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="25">Mode 0 (cycles trough chases 1-8)</Capability>
  <Capability Min="26" Max="255">Mode 1-9</Capability>
 </Channel>
 <Channel Name="Run Mode">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="0">Dimmer Mode</Capability>
  <Capability Min="1" Max="13" Preset="Alias">Chase Mode
   <Alias Mode="7ch" Channel="Strobe" With="Running Speed"/>
  </Capability>
  <Capability Min="14" Max="27" Preset="Alias">A0 (runs the entire all mode A cycle)
   <Alias Mode="7ch" Channel="Strobe" With="Running Speed"/>
  </Capability>
  <Capability Min="28" Max="139" Preset="Alias">A1-A8
   <Alias Mode="7ch" Channel="Strobe" With="Running Speed"/>
  </Capability>
  <Capability Min="140" Max="153" Preset="Alias">B0 (runs the entire all mode B cycle)
   <Alias Mode="7ch" Channel="Strobe" With="Running Speed"/>
  </Capability>
  <Capability Min="154" Max="255" Preset="Alias">B1-B8
   <Alias Mode="7ch" Channel="Strobe" With="Running Speed"/>
  </Capability>
 </Channel>
