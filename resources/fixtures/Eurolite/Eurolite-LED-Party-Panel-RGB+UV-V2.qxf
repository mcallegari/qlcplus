<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.3.0 GIT</Version>
  <Author>bass42</Author>
 </Creator>
 <Manufacturer>Eurolite</Manufacturer>
 <Model>LED Party Panel RGB+UV V2</Model>
 <Type>Color Changer</Type>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="UV" Preset="IntensityUV"/>
 <Channel Name="Master dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="0" Preset="ShutterOpen">No function</Capability>
  <Capability Min="1" Max="5" Preset="ShutterOpen">Music control</Capability>
  <Capability Min="6" Max="10" Preset="ShutterOpen">No function</Capability>
  <Capability Min="11" Max="255" Preset="StrobeSlowToFast">Strobe with increasing speed</Capability>
 </Channel>
 <Channel Name="Strobe 2">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="15" Preset="ShutterOpen">No function</Capability>
  <Capability Min="16" Max="255" Preset="StrobeSlowToFast">Strobe with increasing speed</Capability>
 </Channel>
 <Channel Name="Color Change Switching">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="0">No function</Capability>
  <Capability Min="1" Max="15">Stop</Capability>
  <Capability Min="16" Max="255">Color change with increasing speed</Capability>
 </Channel>
 <Channel Name="Color Change Fading">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="0">No function</Capability>
  <Capability Min="1" Max="15">Stop</Capability>
  <Capability Min="16" Max="255">Color change with increasing speed</Capability>
 </Channel>
 <Channel Name="Sound Control">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="0">No function</Capability>
  <Capability Min="1" Max="10">Stop</Capability>
  <Capability Min="11" Max="69">Sound-controlled color change switching</Capability>
  <Capability Min="70" Max="159">Sound-controlled color change fading</Capability>
  <Capability Min="160" Max="255">Sound-controlled strobe effect</Capability>
 </Channel>
 <Mode Name="4 Channel">
  <Channel Number="0">Red</Channel>
  <Channel Number="1">Green</Channel>
  <Channel Number="2">Blue</Channel>
  <Channel Number="3">UV</Channel>
 </Mode>
 <Mode Name="6 Channel">
  <Channel Number="0">Red</Channel>
  <Channel Number="1">Green</Channel>
  <Channel Number="2">Blue</Channel>
  <Channel Number="3">UV</Channel>
  <Channel Number="4">Master dimmer</Channel>
  <Channel Number="5">Strobe 2</Channel>
 </Mode>
 <Mode Name="9 Channel">
  <Channel Number="0">Master dimmer</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">UV</Channel>
  <Channel Number="5">Strobe 2</Channel>
  <Channel Number="6">Color Change Switching</Channel>
  <Channel Number="7">Color Change Fading</Channel>
  <Channel Number="8">Sound Control</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="0.8" Width="150" Height="150" Depth="51"/>
  <Lens Name="Other" DegreesMin="15" DegreesMax="15"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Layout Width="3" Height="3"/>
  <Technical PowerConsumption="13" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
