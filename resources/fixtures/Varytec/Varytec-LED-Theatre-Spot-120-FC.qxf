<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.3.0 GIT</Version>
  <Author>Fede79</Author>
 </Creator>
 <Manufacturer>Varytec</Manufacturer>
 <Model>LED Theatre Spot 120 FC</Model>
 <Type>Color Changer</Type>
 <Channel Name="Dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="White" Preset="IntensityWhite"/>
 <Channel Name="Color Macro">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="0">None</Capability>
  <Capability Min="1" Max="14" Preset="ColorMacro" Res1="#edfcfb">Cold White</Capability>
  <Capability Min="15" Max="29" Preset="ColorMacro" Res1="#ffffff">White</Capability>
  <Capability Min="30" Max="44" Preset="ColorMacro" Res1="#add8e6">Light Blue</Capability>
  <Capability Min="45" Max="59" Preset="ColorMacro" Res1="#0000ff">Blue</Capability>
  <Capability Min="60" Max="74" Preset="ColorMacro" Res1="#a020f0">Purple</Capability>
  <Capability Min="75" Max="89" Preset="ColorMacro" Res1="#703be7">Bluish violet</Capability>
  <Capability Min="90" Max="104" Preset="ColorMacro" Res1="#c71585">Reddish violet</Capability>
  <Capability Min="105" Max="119" Preset="ColorMacro" Res1="#de8286">Peach blossom</Capability>
  <Capability Min="120" Max="134" Preset="ColorMacro" Res1="#ffc0cb">Pink</Capability>
  <Capability Min="135" Max="149" Preset="ColorMacro" Res1="#ff0000">Red</Capability>
  <Capability Min="150" Max="164" Preset="ColorMacro" Res1="#ffa500">Orange</Capability>
  <Capability Min="165" Max="179" Preset="ColorMacro" Res1="#ffff00">Yellow</Capability>
  <Capability Min="180" Max="194" Preset="ColorMacro" Res1="#9ef700">Lime</Capability>
  <Capability Min="195" Max="209" Preset="ColorMacro" Res1="#90ee90">Light green</Capability>
  <Capability Min="210" Max="224" Preset="ColorMacro" Res1="#00ff00">Green</Capability>
  <Capability Min="225" Max="239" Preset="ColorMacro" Res1="#00c8c2">Bluish green</Capability>
  <Capability Min="240" Max="255" Preset="ColorMacro" Res1="#40e0d0">Turquoise</Capability>
 </Channel>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="0" Preset="ShutterOpen">No function</Capability>
  <Capability Min="1" Max="255" Preset="StrobeSlowToFast">Strobe (Slow to fast)</Capability>
 </Channel>
 <Channel Name="Auto">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="5">None</Capability>
  <Capability Min="6" Max="240" Preset="SlowToFast">Gradual speed change from slow to fast</Capability>
  <Capability Min="241" Max="254">Automatic colour changes</Capability>
  <Capability Min="255" Max="255">Off</Capability>
 </Channel>
 <Mode Name="4 Channel">
  <Channel Number="0">Red</Channel>
  <Channel Number="1">Green</Channel>
  <Channel Number="2">Blue</Channel>
  <Channel Number="3">White</Channel>
 </Mode>
 <Mode Name="6 Channel">
  <Channel Number="0">Dimmer</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">White</Channel>
  <Channel Number="5">Strobe</Channel>
 </Mode>
 <Mode Name="8 Channel">
  <Channel Number="0">Dimmer</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">White</Channel>
  <Channel Number="5">Color Macro</Channel>
  <Channel Number="6">Strobe</Channel>
  <Channel Number="7">Auto</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="5" Width="185" Height="160" Depth="260"/>
  <Lens Name="Fresnel" DegreesMin="15" DegreesMax="45"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Technical PowerConsumption="135" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
