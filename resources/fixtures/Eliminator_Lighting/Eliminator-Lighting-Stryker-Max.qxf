  <Capability Min="196" Max="223">6800K</Capability>
  <Capability Min="224" Max="251">7500K</Capability>
  <Capability Min="252" Max="255">8500K</Capability>
 </Channel>
 <Channel Name="Color Macros" Preset="ColorMacro"/>
 <Channel Name="Effect">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="0" Preset="SlowToFast">Effect Off</Capability>
  <Capability Min="1" Max="100">Wave</Capability>
  <Capability Min="101" Max="200">Dream</Capability>
  <Capability Min="201" Max="255">Color Chase</Capability>
 </Channel>
 <Channel Name="Glory Red" Preset="IntensityRed"/>
 <Channel Name="Glory Green" Preset="IntensityGreen"/>
 <Channel Name="Glory Blue" Preset="IntensityBlue"/>
 <Channel Name="Glory Dimmer" Preset="IntensityDimmer"/>
 <Channel Name="Glory Effect">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="15">Glory Effect close</Capability>
  <Capability Min="16" Max="35">Glory single LED Effect</Capability>
  <Capability Min="36" Max="55">Glory 3 LED Effect</Capability>
  <Capability Min="56" Max="75">Glory 6 LED Effect</Capability>
  <Capability Min="76" Max="95">Glory 12 LED Effect</Capability>
  <Capability Min="96" Max="115">Glory 3 LED 4 modules Effect</Capability>
  <Capability Min="116" Max="135">Glory 6 LED 4 modules Effect</Capability>
  <Capability Min="136" Max="155">Glory 4 modules Effect</Capability>
  <Capability Min="156" Max="175">Glory loop fill Effect</Capability>
  <Capability Min="176" Max="195">RGB 3 colors rainbow Effect</Capability>
  <Capability Min="196" Max="215">RGB 3 colors Effect</Capability>
  <Capability Min="216" Max="235">Glory rainbow Effect</Capability>
  <Capability Min="236" Max="255">Glory segment Effect</Capability>
 </Channel>
 <Channel Name="Glory Speed">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255" Preset="SlowToFast">Glory Speed</Capability>
 </Channel>
 <Channel Name="Zoom" Preset="BeamZoomBigSmall"/>
 <Channel Name="Inner Rotate">
  <Group Byte="0">Prism</Group>
  <Capability Min="0" Max="127" Preset="RotationIndexed">Positions</Capability>
  <Capability Min="128" Max="190" Preset="RotationClockwiseFastToSlow">Clockwise, fast to slow</Capability>
  <Capability Min="191" Max="192" Preset="RotationStop">Stop</Capability>
  <Capability Min="193" Max="255" Preset="RotationCounterClockwiseSlowToFast">Counter-clockwise, slow to fast</Capability>
 </Channel>
 <Channel Name="Shutter">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="3" Preset="LampOff">Off</Capability>
  <Capability Min="4" Max="127" Preset="StrobeSlowToFast">Strobe, slow to fast</Capability>
  <Capability Min="128" Max="191" Preset="PulseSlowToFast">Pulse Strobe, slow to fast</Capability>
  <Capability Min="192" Max="251" Preset="StrobeRandomSlowToFast">Random Strobe, slow to fast</Capability>
  <Capability Min="252" Max="255" Preset="LampOn">Open</Capability>
 </Channel>
 <Channel Name="Dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Dimmer Fine" Preset="IntensityMasterDimmerFine"/>
 <Channel Name="Pan/Tilt Speed" Preset="SpeedPanTiltFastSlow"/>
 <Channel Name="Reset">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="21">Off</Capability>
  <Capability Min="22" Max="25">No Function</Capability>
  <Capability Min="26" Max="76" Preset="ResetEffects">Reset Effect (hold 3s)</Capability>
