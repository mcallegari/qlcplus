   <Channel>11</Channel>
  </Head>
  <Head>
   <Channel>12</Channel>
   <Channel>13</Channel>
   <Channel>14</Channel>
   <Channel>15</Channel>
  </Head>
  <Head>
   <Channel>16</Channel>
   <Channel>17</Channel>
   <Channel>18</Channel>
   <Channel>19</Channel>
  </Head>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="14900" ColourTemperature="0"/>
  <Dimensions Weight="9.7" Width="414" Height="324" Depth="221"/>
  <Lens Name="Other" DegreesMin="6" DegreesMax="50"/>
  <Focus Type="Head" PanMax="540" TiltMax="270"/>
