<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.3.0 GIT</Version>
  <Author>Bert Hofsink</Author>
 </Creator>
 <Manufacturer>Showtec</Manufacturer>
 <Model>Xpression 2000W Wash Beam</Model>
 <Type>Moving Head</Type>
 <Channel Name="Pan" Preset="PositionPan"/>
 <Channel Name="Pan Fine" Preset="PositionPanFine"/>
 <Channel Name="Tilt" Preset="PositionTilt"/>
 <Channel Name="Tilt Fine" Preset="PositionTiltFine"/>
 <Channel Name="Tilt Infinite">
  <Group Byte="0">Tilt</Group>
  <Capability Min="0" Max="5">No function</Capability>
  <Capability Min="6" Max="130">Clockwise rotation (CW), from slow to fast</Capability>
  <Capability Min="131" Max="255">Counterclockwise rotation (CCW), from slow to fast</Capability>
 </Channel>
 <Channel Name="Pan/Tilt Speed" Preset="SpeedPanTiltFastSlow"/>
 <Channel Name="Dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="4">No function</Capability>
  <Capability Min="5" Max="9" Preset="ShutterOpen">Open</Capability>
  <Capability Min="10" Max="89" Preset="StrobeSlowToFast">Synchronized strobe, from low to high frequency</Capability>
  <Capability Min="90" Max="169" Preset="PulseSlowToFast">Pulse strobe, from low to high frequency</Capability>
  <Capability Min="170" Max="250" Preset="StrobeRandomSlowToFast">Random strobe, from low to high frequency</Capability>
  <Capability Min="251" Max="255" Preset="ShutterOpen">Open</Capability>
 </Channel>
 <Channel Name="Color Macro">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="1">No function</Capability>
  <Capability Min="2" Max="4" Preset="ColorMacro" Res1="#ffffff">White</Capability>
  <Capability Min="5" Max="9" Preset="ColorMacro" Res1="#ff0000">Red</Capability>
  <Capability Min="10" Max="14" Preset="ColorMacro" Res1="#ffff00">Yellow</Capability>
  <Capability Min="15" Max="19" Preset="ColorMacro" Res1="#00ff00">Green</Capability>
  <Capability Min="20" Max="24" Preset="ColorMacro" Res1="#ffa500">Orange</Capability>
  <Capability Min="25" Max="29" Preset="ColorMacro" Res1="#ff00ff">Magenta</Capability>
  <Capability Min="30" Max="34" Preset="ColorMacro" Res1="#00ffff">Cyan</Capability>
  <Capability Min="35" Max="39" Preset="ColorMacro" Res1="#0000ff">Blue</Capability>
  <Capability Min="40" Max="44" Preset="ColorMacro" Res1="#ff0000">Rose Red</Capability>
  <Capability Min="45" Max="49" Preset="ColorMacro" Res1="#caff2d">Lime</Capability>
  <Capability Min="50" Max="54">CTO</Capability>
  <Capability Min="55" Max="59">CTB</Capability>
  <Capability Min="60" Max="64" Preset="ColorMacro" Res1="#a020f0">Purple</Capability>
  <Capability Min="65" Max="69" Preset="ColorMacro" Res1="#0000ff">Congo Blue</Capability>
  <Capability Min="70" Max="255">Reserved</Capability>
 </Channel>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Red Fine" Preset="IntensityRedFine"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Green Fine" Preset="IntensityGreenFine"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="Blue Fine" Preset="IntensityBlueFine"/>
 <Channel Name="White" Preset="IntensityWhite"/>
 <Channel Name="White Fine" Preset="IntensityWhiteFine"/>
 <Channel Name="CTC " Preset="ColorCTCMixer"/>
 <Channel Name="Zoom" Preset="BeamZoomBigSmall"/>
 <Channel Name="Zoom Fine" Preset="BeamZoomFine"/>
 <Channel Name="Control">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="15">No function</Capability>
  <Capability Min="16" Max="23">Pan invert</Capability>
  <Capability Min="24" Max="31">Pan normal</Capability>
  <Capability Min="32" Max="39">Tilt invert</Capability>
  <Capability Min="40" Max="47">Tilt normal</Capability>
  <Capability Min="48" Max="55">No function</Capability>
  <Capability Min="56" Max="63">Dimmer curve linear</Capability>
  <Capability Min="64" Max="71">Dimmer curve square</Capability>
  <Capability Min="72" Max="79">Dimmer curve Inv-square</Capability>
  <Capability Min="80" Max="87">Dimmer curve S-curve</Capability>
  <Capability Min="88" Max="95">No function</Capability>
  <Capability Min="96" Max="103">PWM 1200Hz</Capability>
  <Capability Min="104" Max="111">PWM 2000Hz</Capability>
  <Capability Min="112" Max="119">PWM 4000Hz</Capability>
  <Capability Min="120" Max="127">PWM 6000Hz</Capability>
  <Capability Min="128" Max="135">PWM 15000Hz</Capability>
  <Capability Min="136" Max="143">No function</Capability>
  <Capability Min="144" Max="151">Color mixing RGBW</Capability>
  <Capability Min="152" Max="159">Color mixing CMY</Capability>
  <Capability Min="160" Max="167">No function</Capability>
  <Capability Min="168" Max="175">Tilt range 280°</Capability>
  <Capability Min="176" Max="183">Tilt range 360°</Capability>
  <Capability Min="184" Max="191">No function</Capability>
  <Capability Min="192" Max="199">Blackout during pan/tilt movement on</Capability>
  <Capability Min="200" Max="207">Blackout during pan/tilt movement off</Capability>
  <Capability Min="208" Max="215">Blackout during zoom movement on</Capability>
  <Capability Min="216" Max="223">Blackout during zoom movement off</Capability>
  <Capability Min="224" Max="231">No function</Capability>
  <Capability Min="232" Max="239" Preset="ResetPanTilt">Pan-Tilt reset</Capability>
  <Capability Min="240" Max="247" Preset="ResetZoom">Zoom reset</Capability>
  <Capability Min="248" Max="255" Preset="ResetAll">Reset all</Capability>
 </Channel>
