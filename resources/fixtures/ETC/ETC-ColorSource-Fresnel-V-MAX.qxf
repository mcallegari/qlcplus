 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="Indigo" Preset="IntensityIndigo"/>
 <Channel Name="Lime" Preset="IntensityLime"/>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="0" Preset="ShutterOpen">Shutter open</Capability>
  <Capability Min="1" Max="40" Preset="StrobeSlowToFast">Dark Strobe</Capability>
  <Capability Min="41" Max="80" Preset="StrobeSlowToFast">Bright Strobe</Capability>
  <Capability Min="81" Max="120" Preset="PulseSlowToFast">Pulse Strobe</Capability>
  <Capability Min="121" Max="160" Preset="StrobeRandom">Random Strobe</Capability>
  <Capability Min="161" Max="200">Flicker Effect</Capability>
  <Capability Min="201" Max="240" Preset="ShutterOpen">No Strobe</Capability>
  <Capability Min="241" Max="254" Preset="ShutterClose">LEDs Off</Capability>
  <Capability Min="255" Max="255" Preset="ShutterOpen">No Strobe</Capability>
 </Channel>
 <Channel Name="Zoom" Preset="BeamZoomSmallBig"/>
 <Channel Name="Fan">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="9">Auto</Capability>
  <Capability Min="10" Max="19">Off</Capability>
  <Capability Min="20" Max="20">Slow</Capability>
  <Capability Min="21" Max="248">Linear Increase of Speed</Capability>
  <Capability Min="249" Max="249">Fast</Capability>
  <Capability Min="250" Max="255">Auto</Capability>
 </Channel>
