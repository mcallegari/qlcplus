  <Capability Min="10" Max="19">Linear</Capability>
  <Capability Min="20" Max="29">Incandescent Red Shift</Capability>
  <Capability Min="30" Max="39">Linear Red Shift</Capability>
  <Capability Min="40" Max="49">Quick</Capability>
