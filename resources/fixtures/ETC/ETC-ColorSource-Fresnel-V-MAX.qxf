 <Channel Name="Green Fine" Preset="IntensityGreenFine"/>
 <Channel Name="Blue Fine" Preset="IntensityBlueFine"/>
 <Channel Name="Indigo Fine" Preset="IntensityIndigoFine"/>
 <Channel Name="Lime Fine" Preset="IntensityLimeFine"/>
 <Channel Name="Curve">
